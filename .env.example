# Local development only. Copy to .env and supply development credentials.

# Convex development deployment (never use the production deployment locally).
CONVEX_DEPLOYMENT=dev:your-development-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
# Required only for deploy/CI workflows; create a development deploy key separately.
CONVEX_DEPLOY_KEY=

# WorkOS development environment. The production dashboard values must not be used here.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a unique local secret of at least 32 characters. Never commit it.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
